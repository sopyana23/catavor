# ==============================================================================
# Catavor Production Docker Caddyfile (N-56 Edge Proxy & Real-IP Enforcement)
# Dipakai oleh layanan `caddy` pada deploy/docker-compose.prod.yml.
# ==============================================================================

{
	email {$ACME_EMAIL:ops@catavor.com}
	# Akses /internal/tls-ask dikunci ke IP statis Caddy (172.28.10.10) lewat TRUSTED_PROXIES; biarkan CUSTOM_DOMAIN_TLS_ASK_SECRET kosong
	on_demand_tls {
		ask http://catavor:8000/internal/tls-ask
	}
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		protocols h1 h2 h3
		timeouts {
			read_body 30s
			read_header 15s
			write 60s
			idle 300s
		}
	}
}

{$CATAVOR_DOMAIN:catavor.com}, www.{$CATAVOR_DOMAIN:catavor.com} {
	# Untuk mode Cloudflare Full (Strict) dengan Origin CA Certificate, buka komentar blok tls berikut
	# dan mount sertifikat pada /etc/ssl/catavor/ di docker-compose.prod.yml:
	# tls /etc/ssl/catavor/origin-cert.pem /etc/ssl/catavor/origin-key.pem {
	#     protocols tls1.2 tls1.3
	# }

	request_body {
		max_size 12MB
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@stream path /api/notifications/stream* /api/v1/notifications/stream*
	handle @stream {
		reverse_proxy catavor:8000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy catavor:8000 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				keepalive 60s
				keepalive_idle_conns 64
			}
		}
	}
}

# Custom Domain Multi-Tenant Storefronts (On-Demand TLS terotorisasi via /internal/tls-ask)
:443 {
	tls {
		on_demand
	}

	request_body {
		max_size 12MB
	}

	encode zstd gzip

	header {
		# Tanpa includeSubDomains/preload agar subdomain unrelated milik merchant tidak terdampak
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle {
		reverse_proxy catavor:8000 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				keepalive 60s
				keepalive_idle_conns 64
			}
		}
	}
}
