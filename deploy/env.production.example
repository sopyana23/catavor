# ==============================================================================
# Catavor Enterprise SaaS — Production Environment Template (Gate 1–4)
#
# CARA PAKAI:
#   1. Jalankan generator kunci CSPRNG untuk membuat berkas deploy/.env.production
#      dengan izin 0600 secara otomatis:
#        bash deploy/generate-prod-secrets.sh
#   2. Sesuaikan domain, kredensial Google OAuth, dan SMTP di deploy/.env.production.
#   3. JANGAN PERNAH meng-commit berkas .env.production ke Git!
# ==============================================================================

# --- 1. Server & Edge Network Isolation (N-15 / N-56) ---
APP_ENV=production
PORT=8000
BIND_ADDR=127.0.0.1
CATAVOR_DOMAIN=catavor.com
APP_URL=https://catavor.com
ALLOWED_ORIGINS=https://catavor.com,https://www.catavor.com
TRUSTED_PROXIES=127.0.0.1,::1

# --- 2. HTTP Strict Transport Security ---
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# --- 3. Cryptographic Secrets & MFA Key Separation (OWASP ASVS L2) ---
# WAJIB dua kunci 256-bit (64 karakter hex) yang BERBEDA satu sama lain.
JWT_SECRET=<GENERATE_WITH_DEPLOY_SCRIPT>
JWT_EXPIRATION_HOURS=12
MFA_ENCRYPTION_KEY=<GENERATE_DISTINCT_WITH_DEPLOY_SCRIPT>
REQUIRE_SEPARATE_MFA_KEY=true
MFA_2FA_ENABLED=true

# --- 4. PostgreSQL 17 Production Connection (TLS Mandatory) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=catavor_app
DB_PASSWORD=<GENERATE_DB_PASSWORD_WITH_DEPLOY_SCRIPT>
DB_NAME=catavor
DB_SSLMODE=require
DB_AUTO_MIGRATE=false
SKIP_DB_MIGRATE=false

# --- 5. Redis 7 Security State Store (Fail-Closed Mandatory in Production) ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=<GENERATE_REDIS_PASSWORD_WITH_DEPLOY_SCRIPT>
REDIS_DB=0

# --- 6. Google OAuth2 SSO ---
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://catavor.com

# --- 7. Tri-Frontend Static Bundles & Isolated Private Storage ---
DESKTOP_DIST_DIR=/opt/catavor/public/desktop
TABLET_DIST_DIR=/opt/catavor/public/tablet
MOBILE_DIST_DIR=/opt/catavor/public/mobile

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/catavor/storage
STORAGE_PRIVATE_ROOT=/var/lib/catavor/private_storage
STORAGE_PUBLIC_URL=https://catavor.com/storage

# --- 8. Opsional: Object Storage S3 / Cloudflare R2 (jika STORAGE_DRIVER=s3) ---
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=catavor-prod-uploads
S3_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_ACCESS_KEY>
S3_USE_PATH_STYLE=false
S3_SSL=true

# --- 9. Transactional Email Outbox (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@catavor.com
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_FROM=no-reply@catavor.com
SMTP_FROM_NAME="Catavor"

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@catavor.com
MAIL_PASSWORD=<YOUR_SMTP_PASSWORD>
MAIL_FROM_ADDRESS=no-reply@catavor.com
MAIL_FROM_NAME="Catavor"
