# Root GitIgnore for Catavor Monorepo

# Dependencies
**/node_modules/
**/vendor/
**/dist/

# Environment configurations (Secrets)
**/.env
**/.env.production
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Databases & Dynamic Local uploads
**/database/*.sqlite
/public/storage/fauna/*
!/public/storage/fauna/.gitkeep
/backend/storage/uploads/*
!/backend/storage/uploads/.gitkeep
/legacy/laravel/storage/app/public/fauna/*
!/legacy/laravel/storage/app/public/fauna/.gitkeep
*.fiber.gz

# Executables & Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/catavor-server.exe
backend/catavor-server

# IDE, Browser & Temporary files
**/.idea/
**/.vscode/
**/Thumbs.db
**/.DS_Store
*.log
brain/
scratch/
Backups/
Cache/
CachedConfigurations/
CachedData/
CachedProfilesData/
Code Cache/
Crashpad/
DIPS*
Dawn*
GPUCache/
Local State
Local Storage/
Network/
Preferences
Service Worker/
Session Storage/
Shared Dictionary/
SharedStorage*
User/
WebStorage/
blob_storage/
code.lock
languagepacks.json
machineid
