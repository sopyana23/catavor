# Root GitIgnore for Catavor Monorepo

# Dependencies
**/node_modules/
**/vendor/
**/dist/

# Environment configurations (Secrets)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*id_ed25519

# Databases & Dynamic Local uploads
**/database/*.sqlite
*.db
/public/storage/fauna/*
!/public/storage/fauna/.gitkeep
/public/storage/articles/*
!/public/storage/articles/.gitkeep
/public/storage/stores/*
!/public/storage/stores/.gitkeep
/public/storage/support/*
!/public/storage/support/.gitkeep
/public/storage/general/*
!/public/storage/general/.gitkeep
/public/storage/platform/*
!/public/storage/platform/.gitkeep
ext/
# Berkas privat (bukti bayar, lampiran tiket) — TIDAK boleh ada di pohon publik
/backend/storage/private/*
!/backend/storage/private/.gitkeep
/backend/public/storage/*
!/backend/public/storage/.gitkeep
/storage/*
!/storage/.gitkeep
!/storage/private/.gitkeep

# Seluruh dist SPA adalah keluaran build Vite (build.emptyOutDir = true):
# tiap `npm run build` mengosongkan folder ini lalu menyalin ulang isi
# frontend/<app>/public/. Aset "statis" di dalamnya (pdfjs, logo, favicon,
# icons) adalah salinan — sumber aslinya frontend/<app>/public/ dan tetap
# ter-commit. Dockerfile membangun ketiga SPA sendiri, jadi dist tidak pernah
# dipakai saat deploy. Membiarkannya di-commit membuat public/<app>/index.html
# merujuk hash aset yang tidak ada di checkout lain (halaman blank).
/public/desktop/
/public/tablet/
/public/mobile/
# public/assets, public/img, public/logo.png, public/favicon.ico, dan
# public/storage/ BUKAN keluaran vite (di luar outDir) — tetap di-commit.
/legacy/laravel/storage/app/public/fauna/*
!/legacy/laravel/storage/app/public/fauna/.gitkeep
*.fiber.gz

# Executables & Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/catavor-server.exe
backend/catavor-server

# IDE, Browser & Temporary files
**/.idea/
**/.vscode/
**/Thumbs.db
**/.DS_Store
*.log
brain/
scratch/
Backups/
Cache/
CachedConfigurations/
CachedData/
CachedExtensionVSIXs/
CachedProfilesData/
*.vsix
Code Cache/
Crashpad/
DIPS*
Dawn*
GPUCache/
Local State
Local Storage/
Network/
Preferences
Service Worker/
Session Storage/
Shared Dictionary/
SharedStorage*
User/
WebStorage/
blob_storage/
code.lock
languagepacks.json
machineid

# Coverage dari go test
backend/coverage.out

# Graphify knowledge graph artifacts
graphify-out/

