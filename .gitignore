# Root GitIgnore for Catavor Monorepo

# Dependencies
**/node_modules/
**/vendor/
**/dist/

# Environment configurations (Secrets)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*id_ed25519

# Databases & Dynamic Local uploads
**/database/*.sqlite
*.db
/public/storage/fauna/*
!/public/storage/fauna/.gitkeep
/public/storage/articles/*
!/public/storage/articles/.gitkeep
/public/storage/stores/*
!/public/storage/stores/.gitkeep
/public/storage/support/*
!/public/storage/support/.gitkeep
/backend/public/storage/*
!/backend/public/storage/.gitkeep
/legacy/laravel/storage/app/public/fauna/*
!/legacy/laravel/storage/app/public/fauna/.gitkeep
*.fiber.gz

# Executables & Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/catavor-server.exe
backend/catavor-server

# IDE, Browser & Temporary files
**/.idea/
**/.vscode/
**/Thumbs.db
**/.DS_Store
*.log
brain/
scratch/
Backups/
Cache/
CachedConfigurations/
CachedData/
CachedExtensionVSIXs/
CachedProfilesData/
*.vsix
Code Cache/
Crashpad/
DIPS*
Dawn*
GPUCache/
Local State
Local Storage/
Network/
Preferences
Service Worker/
Session Storage/
Shared Dictionary/
SharedStorage*
User/
WebStorage/
blob_storage/
code.lock
languagepacks.json
machineid

# Coverage dari go test
backend/coverage.out
