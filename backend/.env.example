# =========================================================================
# Catavor Enterprise SaaS - Environment Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets (.env) to version control!
# =========================================================================

# Server & Environment
PORT=8000
APP_ENV=local                       # Options: local | staging | production
APP_URL=http://localhost:8000

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=catavor
DB_SSLMODE=disable                  # Options: disable | require | verify-full
DB_AUTO_MIGRATE=false               # Options: true | false

# Redis Cache & Session Store (Optional - Fallbacks to in-memory gracefully)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Authentication & Security
# WARNING: In production, generate a secure 256-bit random key (e.g. openssl rand -hex 32)
JWT_SECRET=catavor_super_secret_jwt_key_2026_enterprise_saas
JWT_EXPIRATION_HOURS=72

# Google OAuth2 SSO Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000

# Static & Legacy Migration Paths
SQLITE_SOURCE_PATH=legacy/laravel/database/database.sqlite
STORAGE_DIR=public/storage
DESKTOP_DIST_DIR=public/desktop
MOBILE_DIST_DIR=public/mobile

# Cloud Object Storage (S3 / MinIO / Cloudflare R2 / AWS / Local)
# Options: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=public/storage
STORAGE_PUBLIC_URL=http://localhost:8000/storage

# S3 / MinIO / Cloudflare R2 Settings (Required if STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=catavor-uploads
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_USE_PATH_STYLE=true
S3_SSL=false

# CORS & Trusted Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:3000

# Transactional Email & Outbox SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="Catavor"

# Framework Mailer Compatibility Aliases (Laravel / CI4)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Catavor"
